# Copier ce fichier en .env puis compléter. Ne jamais publier le .env.
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stockparfum

# JWT : mettre une longue chaîne aléatoire (obligatoire)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Envoi d'images produits
UPLOAD_DIR=uploads/products
MAX_UPLOAD_SIZE_MB=5

# Compte administrateur créé par « npm run seed » (changer le mot de passe)
SEED_ADMIN_NAME=Administrateur
SEED_ADMIN_EMAIL=admin@stockparfum.mg
SEED_ADMIN_PASSWORD=
